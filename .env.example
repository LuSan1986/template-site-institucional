# Variáveis de Ambiente — copie este arquivo para .env.local e preencha os valores reais.
# Nunca commite o arquivo .env.local.

# URL pública do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Nome do site (usado em meta tags e SEO)
NEXT_PUBLIC_SITE_NAME=Nome do Site

# E-mail de destino para o formulário de contato
CONTACT_EMAIL=contato@seudominio.com.br

# Google Analytics — ID de medição (formato: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager — ID do container (formato: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Chave de API para serviço de envio de e-mails (ex: Resend, SendGrid)
EMAIL_API_KEY=

# Variáveis opcionais para integrações futuras

# reCAPTCHA v3 (protege formulários de spam)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
